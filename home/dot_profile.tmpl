# ~/.profile -- POSIX env + aliases, read by login shells and by any sh script.
# Managed by chezmoi. OS-specific blocks are templated per .chezmoi.os.
#
# This file owns environment and aliases; ~/.bashrc owns interactive bash
# behaviour (prompt, history, completion). The two source each other so that
# both login and non-login shells end up with everything -- the __*_SOURCED
# guards below are what stop that from looping.
__PROFILE_SOURCED=1

# Prepend to PATH only if absent. Nested shells (tmux, a bash inside a bash)
# re-read this file, and a plain prepend would grow PATH on every level.
__path_prepend() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

# locale -- only export if the system has it generated. Ubuntu/WSL images often
# ship C.UTF-8 only, and setting a missing locale makes bash warn on every start.
# To get it: sudo locale-gen en_US.UTF-8 && sudo update-locale
if locale -a 2>/dev/null | grep -qiE '^en_US\.utf-?8$'; then
  export LANG="en_US.UTF-8"
fi

{{- if eq .chezmoi.os "darwin" }}

# --- macOS / Homebrew (Apple Silicon) ---
export HOMEBREW_CASK_OPTS="--appdir=/Applications"
eval "$(/opt/homebrew/bin/brew shellenv)"
export CPPFLAGS="-I/opt/homebrew/opt/openjdk/include"
__path_prepend "/opt/homebrew/opt/libiconv/bin"
{{- else if eq .chezmoi.os "linux" }}

# --- Linux / Homebrew (if installed) ---
[ -d /home/linuxbrew/.linuxbrew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}

# pyenv. Add the bin only if it exists, so a machine without pyenv does not carry
# a dead entry; still init whenever pyenv is on PATH, which covers a package
# manager install that does not live under PYENV_ROOT.
export PYENV_ROOT="$HOME/.pyenv"
[ -d "$PYENV_ROOT/bin" ] && __path_prepend "$PYENV_ROOT/bin"
command -v pyenv >/dev/null && eval "$(pyenv init -)"

# user-local binaries (pipx, chezmoi)
[ -d "$HOME/.local/bin" ] && __path_prepend "$HOME/.local/bin"

# bun
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && __path_prepend "$BUN_INSTALL/bin"

# pnpm
{{- if eq .chezmoi.os "darwin" }}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else }}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}
# PNPM_HOME stays exported either way: `pnpm setup` reads it to decide where to
# install. Only the PATH entry is conditional on the directory existing.
[ -d "$PNPM_HOME" ] && __path_prepend "$PNPM_HOME"

# go
export GOPRIVATE="github.com/Delivr-Ai/*"
[ -d "$HOME/go/bin" ] && __path_prepend "$HOME/go/bin"

export PATH

# aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

alias g='git'
alias gs='git status'
alias gc='git commit'
alias gp='git push'
alias gpl='git pull'
alias gco='git checkout'
alias gcb='git checkout -b'

# claude code, no permission prompts -- every tool call runs unconfirmed
alias ccd='claude --dangerously-skip-permissions'

{{- if eq .chezmoi.os "darwin" }}
alias pwdc='pwd | pbcopy'
{{- else }}
# Linux clipboard: Wayland (wl-copy) -> X11 (xclip) -> WSL (clip.exe)
if command -v wl-copy >/dev/null; then
  alias pwdc='pwd | tr -d "\n" | wl-copy'
elif command -v xclip >/dev/null; then
  alias pwdc='pwd | tr -d "\n" | xclip -selection clipboard'
elif command -v clip.exe >/dev/null; then
  alias pwdc='pwd | tr -d "\n" | clip.exe'
fi
{{- end }}

# A login bash reads this file but not ~/.bashrc, so pull the interactive
# config in here. Skipped when ~/.bashrc is what sourced us.
if [ -n "${BASH_VERSION-}" ] && [ -z "${__BASHRC_SOURCED-}" ] && [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
